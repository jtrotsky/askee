{
  "title": "my-box",
  "vm": "http://127.0.0.1:8428",
  "default_range": "24h",
  "default_theme": "auto",
  "thermal_range": [
    30,
    100
  ],
  "events": [
    {
      "label": "reboot",
      "expr": "node_boot_time_seconds"
    }
  ],
  "groups": [
    {
      "id": "system",
      "title": "System"
    },
    {
      "id": "memory",
      "title": "Memory"
    },
    {
      "id": "network",
      "title": "Network"
    }
  ],
  "pages": [
    {
      "id": "cpu",
      "group": "system",
      "kind": "line",
      "title": "CPU busy",
      "unit": "%",
      "ymin": 0,
      "ymax": 100,
      "stack": true,
      "series": [
        {
          "expr": "100 * avg(rate(node_cpu_seconds_total{mode=\"system\"}))",
          "name": "kernel"
        },
        {
          "expr": "100 * avg(rate(node_cpu_seconds_total{mode=\"user\"}))",
          "name": "apps"
        },
        {
          "expr": "100 * avg(rate(node_cpu_seconds_total{mode=~\"nice|interrupt\"}))",
          "name": "other"
        }
      ],
      "live": true
    },
    {
      "id": "temp",
      "group": "system",
      "kind": "line",
      "title": "CPU temperature",
      "unit": "°C",
      "thermal": true,
      "series": [
        {
          "expr": "max(node_cpu_temperature_celsius)",
          "name": "hottest core"
        }
      ],
      "refs": [
        {
          "value": 95,
          "label": "hot"
        },
        {
          "value": 105,
          "label": "limit"
        }
      ],
      "live": true
    },
    {
      "id": "load",
      "group": "system",
      "kind": "line",
      "title": "Load",
      "unit": "",
      "ymin": 0,
      "series": [
        {
          "expr": "node_load1",
          "name": "1 min"
        },
        {
          "expr": "node_load15",
          "name": "15 min"
        }
      ],
      "refs": [
        {
          "value": 4,
          "label": "4 cores"
        }
      ],
      "live": true
    },
    {
      "id": "cpu_hour",
      "group": "system",
      "kind": "hour",
      "title": "CPU busy by hour",
      "unit": "%",
      "range": "30d",
      "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1h])))"
    },
    {
      "id": "mem",
      "group": "memory",
      "kind": "line",
      "title": "Memory use",
      "unit": "GiB",
      "ymin": 0,
      "stack": true,
      "series": [
        {
          "expr": "node_zfs_arcstats_size_bytes / 2^30",
          "name": "ZFS cache"
        },
        {
          "expr": "(node_memory_wired_bytes - node_zfs_arcstats_size_bytes) / 2^30",
          "name": "kernel"
        },
        {
          "expr": "node_memory_active_bytes / 2^30",
          "name": "active"
        },
        {
          "expr": "node_memory_inactive_bytes / 2^30",
          "name": "inactive"
        },
        {
          "expr": "(node_memory_laundry_bytes + node_memory_free_bytes) / 2^30",
          "name": "free"
        }
      ],
      "refs": [
        {
          "expr": "node_memory_size_bytes / 2^30",
          "label": "RAM"
        }
      ],
      "live": true
    },
    {
      "id": "swap",
      "group": "memory",
      "kind": "line",
      "title": "Swap used",
      "unit": "MiB",
      "ymin": 0,
      "series": [
        {
          "expr": "node_memory_swap_used_bytes / 2^20",
          "name": "used"
        }
      ],
      "refs": [
        {
          "expr": "node_memory_swap_size_bytes / 2^20",
          "label": "swap size"
        }
      ],
      "live": true
    },
    {
      "id": "arc_hit",
      "group": "memory",
      "kind": "line",
      "title": "ZFS cache hits",
      "unit": "%",
      "ymax": 100,
      "series": [
        {
          "expr": "100 * rate(node_zfs_arcstats_hits_total) / (rate(node_zfs_arcstats_hits_total) + rate(node_zfs_arcstats_misses_total))",
          "name": "all reads"
        },
        {
          "expr": "100 * rate(node_zfs_arcstats_demand_data_hits_total) / (rate(node_zfs_arcstats_demand_data_hits_total) + rate(node_zfs_arcstats_demand_data_misses_total))",
          "name": "file data"
        }
      ]
    },
    {
      "id": "wan",
      "group": "network",
      "kind": "line",
      "title": "Network traffic",
      "unit": "MB/s",
      "ymin": 0,
      "series": [
        {
          "expr": "rate(node_network_receive_bytes_total{device=\"igc0\"}) / 1e6",
          "name": "in"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device=\"igc0\"}) / 1e6",
          "name": "out"
        }
      ],
      "live": true
    }
  ]
}
