{
  "groups": [{"id": "memory", "title": "Memory"}],
  "pages": [
    {"id": "mem", "group": "memory", "kind": "line", "live": true, "title": "Memory use", "unit": "GiB", "stack": true, "ymin": 0, "info": "Inactive memory and the ZFS cache give memory back under pressure.", "requires": "node_memory_wired_bytes{$node}", "series": [{"expr": "sum(node_zfs_arcstats_size_bytes{$node}) / 2^30", "name": "ZFS cache"}, {"expr": "(sum(node_memory_wired_bytes{$node}) - (sum(node_zfs_arcstats_size_bytes{$node}) or vector(0))) / 2^30", "name": "kernel"}, {"expr": "sum(node_memory_active_bytes{$node}) / 2^30", "name": "active"}, {"expr": "sum(node_memory_inactive_bytes{$node}) / 2^30", "name": "inactive"}, {"expr": "(sum(node_memory_laundry_bytes{$node}) or vector(0)) / 2^30 + sum(node_memory_free_bytes{$node}) / 2^30", "name": "free"}], "refs": [{"expr": "sum(node_memory_size_bytes{$node}) / 2^30", "label": "RAM"}]},
    {"id": "mem_linux", "group": "memory", "kind": "line", "live": true, "title": "Memory use", "unit": "GiB", "stack": true, "ymin": 0, "info": "The kernel hands cache back the moment an app asks.", "requires": "node_memory_MemAvailable_bytes{$node}", "series": [{"expr": "sum(node_memory_MemTotal_bytes{$node} - node_memory_MemAvailable_bytes{$node}) / 2^30", "name": "used"}, {"expr": "sum(node_memory_MemAvailable_bytes{$node} - node_memory_MemFree_bytes{$node}) / 2^30", "name": "cache"}, {"expr": "sum(node_memory_MemFree_bytes{$node}) / 2^30", "name": "free"}], "refs": [{"expr": "sum(node_memory_MemTotal_bytes{$node}) / 2^30", "label": "RAM"}]},
    {"id": "swap", "group": "memory", "kind": "line", "live": true, "title": "Swap used", "unit": "MiB", "ymin": 0, "info": "At the dashed line swap is full and the kernel starts killing processes.", "requires": "(sum(node_memory_swap_size_bytes{$node}) or sum(node_memory_SwapTotal_bytes{$node})) > 0", "series": [{"expr": "(sum(node_memory_swap_used_bytes{$node}) or sum(node_memory_SwapTotal_bytes{$node} - node_memory_SwapFree_bytes{$node})) / 2^20", "name": "used"}], "refs": [{"expr": "(sum(node_memory_swap_size_bytes{$node}) or sum(node_memory_SwapTotal_bytes{$node})) / 2^20", "label": "swap size"}]},
    {"id": "swap_io", "group": "memory", "kind": "line", "live": true, "title": "Swap activity", "unit": "MiB/s", "ymin": 0, "ymax": 1, "info": "A steady flow here means memory is short, unlike swap used, which can be old pages nothing needs.", "series": [{"expr": "(sum(rate(node_memory_swap_in_bytes_total{$node}$__rate)) or sum(rate(node_vmstat_pswpin{$node}$__rate)) * 4096) / 2^20", "name": "in"}, {"expr": "(sum(rate(node_memory_swap_out_bytes_total{$node}$__rate)) or sum(rate(node_vmstat_pswpout{$node}$__rate)) * 4096) / 2^20", "name": "out"}]},
    {"id": "arc_hit", "group": "memory", "kind": "line", "live": true, "title": "ZFS cache misses", "unit": "%", "ymin": 0, "info": "Misses rise while a backup or scrub reads the disks.", "requires": "node_zfs_arcstats_hits_total{$node} or node_zfs_arc_hits{$node}", "series": [{"expr": "100 - 100 * sum(rate(node_zfs_arcstats_hits_total{$node}$__rate)) / (sum(rate(node_zfs_arcstats_hits_total{$node}$__rate)) + sum(rate(node_zfs_arcstats_misses_total{$node}$__rate))) or 100 - 100 * sum(rate(node_zfs_arc_hits{$node}$__rate)) / (sum(rate(node_zfs_arc_hits{$node}$__rate)) + sum(rate(node_zfs_arc_misses{$node}$__rate)))", "name": "all reads"}, {"expr": "100 - 100 * sum(rate(node_zfs_arcstats_demand_data_hits_total{$node}$__rate)) / (sum(rate(node_zfs_arcstats_demand_data_hits_total{$node}$__rate)) + sum(rate(node_zfs_arcstats_demand_data_misses_total{$node}$__rate))) or 100 - 100 * sum(rate(node_zfs_arc_demand_data_hits{$node}$__rate)) / (sum(rate(node_zfs_arc_demand_data_hits{$node}$__rate)) + sum(rate(node_zfs_arc_demand_data_misses{$node}$__rate)))", "name": "file data"}]},
    {"id": "arc_size", "group": "memory", "kind": "line", "live": true, "title": "ZFS cache size", "unit": "GiB", "ymin": 0, "info": "The target falls when the kernel wants memory back.", "requires": "node_zfs_arcstats_size_bytes{$node} or node_zfs_arc_size{$node}", "series": [{"expr": "(sum(node_zfs_arcstats_size_bytes{$node}) or sum(node_zfs_arc_size{$node})) / 2^30", "name": "size"}, {"expr": "(sum(node_zfs_arcstats_c_bytes{$node}) or sum(node_zfs_arc_c{$node})) / 2^30", "name": "target"}], "refs": [{"expr": "(sum(node_zfs_arcstats_c_max_bytes{$node}) or sum(node_zfs_arc_c_max{$node})) / 2^30", "label": "max"}]}
  ]
}
