{
  "groups": [{"id": "storage", "title": "Storage"}],
  "pages": [
    {"id": "fs_full", "group": "storage", "kind": "instant", "title": "Fullest filesystems", "unit": "%", "label": "mountpoint", "limit": 8, "info": "Past the dashed line, writes slow or fail.", "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|devtmpfs|devfs|fdescfs|procfs|linprocfs|linsysfs|nullfs|overlay|squashfs|autofs|fuse.*|nsfs|ramfs|cgroup2?|proc|sysfs|mqueue|tracefs|debugfs|securityfs|pstore|efivarfs|bpf|configfs|hugetlbfs|binfmt_misc|rpc_pipefs|devpts|iso9660|udf\",$node} / (node_filesystem_size_bytes{fstype!~\"tmpfs|devtmpfs|devfs|fdescfs|procfs|linprocfs|linsysfs|nullfs|overlay|squashfs|autofs|fuse.*|nsfs|ramfs|cgroup2?|proc|sysfs|mqueue|tracefs|debugfs|securityfs|pstore|efivarfs|bpf|configfs|hugetlbfs|binfmt_misc|rpc_pipefs|devpts|iso9660|udf\",$node} > 0))", "refs": [{"value": 90, "label": "nearly full"}]},
    {"id": "root_free", "group": "storage", "kind": "line", "title": "Free space on /", "unit": "GB", "info": "A steady slope down is a log or cache that never shrinks.", "requires": "node_filesystem_avail_bytes{mountpoint=\"/\",$node}", "series": [{"expr": "max(node_filesystem_avail_bytes{mountpoint=\"/\",$node}) / 1e9", "name": "free"}]},
    {"id": "disk_io", "group": "storage", "kind": "line", "title": "Disk traffic", "unit": "MB/s", "ymin": 0, "ymax": 10, "info": "Whole disks only, so partitions and volumes do not count twice.", "requires": "node_disk_read_bytes_total{$node} or node_devstat_bytes_total{$node}", "series": [{"expr": "(sum(rate(node_disk_read_bytes_total{device=~\"sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|xvd[a-z]+|hd[a-z]+|mmcblk[0-9]+\",$node}$__rate)) or sum(rate(node_devstat_bytes_total{type=\"read\",$node}$__rate))) / 1e6", "name": "read"}, {"expr": "(sum(rate(node_disk_written_bytes_total{device=~\"sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|xvd[a-z]+|hd[a-z]+|mmcblk[0-9]+\",$node}$__rate)) or sum(rate(node_devstat_bytes_total{type=\"write\",$node}$__rate))) / 1e6", "name": "write"}]}
  ]
}
