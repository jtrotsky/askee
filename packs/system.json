{
  "groups": [{"id": "system", "title": "System"}],
  "events": [{"label": "reboot", "expr": "node_boot_time_seconds{$node}"}],
  "pages": [
    {"id": "cpu", "group": "system", "kind": "line", "title": "CPU busy", "unit": "%", "live": true, "stack": true, "ymin": 0, "ymax": 100, "info": "Kernel is the operating system's own work, and waiting is time stalled on disk or a busy host (Linux only).", "series": [{"expr": "100 * sum(rate(node_cpu_seconds_total{mode=~\"system|interrupt|irq|softirq\",$node}$__rate)) / sum(rate(node_cpu_seconds_total{$node}$__rate))", "name": "kernel"}, {"expr": "100 * sum(rate(node_cpu_seconds_total{mode=~\"user|nice\",$node}$__rate)) / sum(rate(node_cpu_seconds_total{$node}$__rate))", "name": "apps"}, {"expr": "100 * sum(rate(node_cpu_seconds_total{mode=~\"iowait|steal\",$node}$__rate)) / sum(rate(node_cpu_seconds_total{$node}$__rate))", "name": "waiting"}]},
    {"id": "temp", "group": "system", "kind": "line", "title": "CPU temperature", "unit": "°C", "live": true, "thermal": true, "info": "The dashed line, where the sensor reports one, is its critical limit.", "requires": "max(node_cpu_temperature_celsius{$node}) or max(node_hwmon_temp_celsius{chip=~\".*(coretemp|k10temp|zenpower|cpu_thermal|soc_thermal).*\",$node}) or max(node_thermal_zone_temp{type=~\"x86_pkg_temp|cpu.*|soc.*\",$node})", "series": [{"expr": "max(node_cpu_temperature_celsius{$node}) or max(node_hwmon_temp_celsius{chip=~\".*(coretemp|k10temp|zenpower|cpu_thermal|soc_thermal).*\",$node}) or max(node_thermal_zone_temp{type=~\"x86_pkg_temp|cpu.*|soc.*\",$node})", "name": "hottest"}], "refs": [{"expr": "max(node_hwmon_temp_crit_celsius{chip=~\".*(coretemp|k10temp|zenpower).*\",$node})", "label": "limit"}]},
    {"id": "load", "group": "system", "kind": "line", "title": "Load", "live": true, "ymin": 0, "info": "Above the dashed line, the core count, work is queueing on disk as often as on CPU.", "series": [{"expr": "node_load1{$node}", "name": "1 min"}, {"expr": "node_load15{$node}", "name": "15 min"}], "refs": [{"expr": "count(count by (cpu) (node_cpu_seconds_total{$node}))", "label": "cores"}]},
    {"id": "cpu_hour", "group": "system", "kind": "hour", "title": "CPU busy by hour", "unit": "%", "info": "When in the day the scheduled work runs, averaged over 30 days.", "expr": "100 * (1 - sum(rate(node_cpu_seconds_total{mode=\"idle\",$node}[1h])) / sum(rate(node_cpu_seconds_total{$node}[1h])))"}
  ]
}
